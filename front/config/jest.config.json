{
  "rootDir": "..",
  "resetMocks": true,
  "testEnvironment": "jsdom",
  "moduleFileExtensions": [
    "js",
    "json",
    "vue"
  ],
  "watchman": false,
  "moduleNameMapper": {
    "^~/(.*)$": "<rootDir>/$1",
    "^~~/(.*)$": "<rootDir>/$1",
    "^@/(.*)$": "<rootDir>/$1",
    "^@vue/test-utils$": "<rootDir>/node_modules/@vue/test-utils/dist/vue-test-utils.cjs.js",
    "^ofetch$": "<rootDir>/node_modules/ofetch/dist/index.cjs",
    "^vue$": "<rootDir>/config/jest.vue-shim.js",
    "^@vue/server-renderer$": "<rootDir>/config/jest.server-renderer.mock.js",
    "^#imports$": "<rootDir>/config/jest.mocked-imports.js",
    "^vue-lazyload$": "<rootDir>/config/jest.mocked-vue-lazyload.js",
    "^vue-js-modal$": "<rootDir>/config/jest.mocked-vue-modal.js"
  },
  "transform": {
    "^.+\\.js$": "babel-jest",
    ".*\\.(vue)$": "@vue/vue3-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@vue|vue|vue-router|vue-i18n)/)"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 90,
      "functions": 80,
      "lines": 85,
      "statements": 85
    }
  },
  "snapshotSerializers": [
    "<rootDir>/config/jest.vue-wrapper-serializer.js"
  ],
  "setupFilesAfterEnv": [
    "<rootDir>/config/jest.setup.js"
  ],
  "collectCoverageFrom": [
    "<rootDir>/components/**/*.vue",
    "<rootDir>/pages/*.vue",
    "!<rootDir>/components/FeedbackModal/*.vue",
    "!<rootDir>/components/SubscribeModal/*.vue"
  ],
  "coverageProvider": "v8"
}
