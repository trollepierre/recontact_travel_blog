{
  "name": "recontact_travel_blog-front",
  "version": "1.0.0",
  "description": "Travel blog of Pierre",
  "author": "Pierre<pierre@recontact.me>",
  "license": "MIT",
  "packageManager": "yarn@1.22.19",
  "scripts": {
    "prepare:env": "node scripts/ensure-env.mjs",
    "clean": "yarn clean:dependencies && yarn clean:nuxt:files  && yarn clean:dist",
    "clean:nuxt:files": "rm -rf .nuxt .output",
    "clean:dependencies": "rm -rf node_modules",
    "clean:dist": "rm -rf dist",
    "predev": "yarn prepare:env",
    "dev": "PORT=3333 npx nuxi dev",
    "pregenerate": "yarn prepare:env",
    "generate": "yarn generate:fr",
    "generate:en": "NUXT_ENV_LANGUAGE=en nuxi generate",
    "generate:fr": "NUXT_ENV_LANGUAGE=fr nuxi generate",
    "start": "yarn dev",
    "lint": "eslint --ext .js,.vue .",
    "lint:fix": "yarn lint --fix",
    "precommit": "yarn lint:fix",
    "test": "env TZ=\"Europe/Paris\" jest --config config/jest.config.json",
    "test:coverage": "yarn test --coverage"
  },
  "dependencies": {
    "@babel/runtime": "7.18.9",
    "@pinia/nuxt": "^0.5.1",
    "dotenv": "^10.0.0",
    "mapbox-gl": "^2.15.0",
    "nuxt": "^3.21",
    "ofetch": "^1.5.1",
    "pinia": "^2.1.7",
    "vue": "^3.5",
    "vue-i18n": "^9.8.0",
    "vue3-lazyload": "^0.4"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/eslint-parser": "^7.29",
    "@babel/plugin-transform-runtime": "7.28.5",
    "@babel/preset-env": "7.29.7",
    "@vue/server-renderer": "^3.5",
    "@vue/test-utils": "^2.4",
    "@vue/vue3-jest": "^29.2.5",
    "babel-jest": "^29.7.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-friendly-formatter": "4.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "26.9.0",
    "eslint-plugin-vue": "9.33.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-serializer-vue": "2.0.2",
    "prettier": "^2.7.1",
    "pretty-format": "^30.4",
    "sass": "^1.102",
    "sass-embedded": "^1.102",
    "strip-ansi": "6.0.0",
    "typescript": "^5.0.2",
    "vue-router": "^4.4.5",
    "vuex": "^4.1.0"
  },
  "resolutions": {
    "brace-expansion": "^2.1.4",
    "browserslist": "^4.28.7",
    "cookie": "^0.7.2",
    "cross-spawn": "^7.0.5",
    "defu": "^6.1.5",
    "flatted": "^3.4.2",
    "form-data": "^4.0.6",
    "js-cookie": "^3.0.7",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "qs": "^6.16.0",
    "semver": "^7.5.2",
    "serialize-javascript": "^7.0.5",
    "tar": "^7.5.22",
    "validator": "^13.15.22",
    "ws": "^8.21.0"
  },
  "engines": {
    "yarn": "1.22",
    "node": "22.22"
  }
}
